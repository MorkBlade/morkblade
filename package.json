{
  "name": "newkeyboard",
  "version": "0.0.0",
  "private": true,
  "main": "./src-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite && electron .",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "@jaames/iro": "^5.5.2",
    "@sparklinkplayjoy/sdk-keyboard": "1.0.2",
    "axios": "^1.6.7",
    "echarts": "^5.5.1",
    "element-plus": "^2.9.5",
    "mitt": "^3.0.1",
    "pinia": "^3.0.1",
    "qs": "^6.11.2",
    "tdesign-vue-next": "^1.13.2",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "electron": "^32.3.3",
    "electron-builder": "^25.0.5",
    "electron-devtools-installer": "^3.2.0",
    "eslint": "^9.20.1",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.5.1",
    "sass": "^1.85.1",
    "sass-loader": "^16.0.5",
    "unplugin-auto-import": "^19.1.0",
    "unplugin-vue-components": "^28.4.0",
    "vite": "^6.1.0",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vite-plugin-electron": "^0.28.7"
  },
  "build": {
    "productName": "morkblade",
    "appId": "morkblade.electronapp",
    "copyright": "morkblade © 2025",
    "compression": "maximum",
    "asar": true,
    "directories": {
      "output": "release/"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "morkblade"
    },
    "win": {
      "icon": "./public/logo.ico",
      "artifactName": "${productName}-v${version}-${platform}-setup.${ext}",
      "target": [
        {
          "target": "nsis"
        }
      ]
    },
    "mac": {
      "icon": "./public/logo.ico",
      "artifactName": "${productName}-v${version}-${platform}-setup.${ext}"
    },
    "linux": {
      "icon": "./public/logo.ico",
      "artifactName": "${productName}-v${version}-${platform}-setup.${ext}"
    }
  },
  "pnpm": {
    "overrides": {
      "@sparklinkplayjoy/sdk-keyboard": "link:../../SDK/sdk/keyboard"
    }
  }
}
